{
  "id": "com.syncu.panel",
  "name": "Syncu",
  "version": "0.1.3",
  "main": "index.html",
  "manifestVersion": 5,
  "host": [
    {
      "app": "premierepro",
      "minVersion": "26.2.0"
    }
  ],
  "requiredPermissions": {
    "localFileSystem": "fullAccess",
    "network": {
      "domains": "all"
    },
    "clipboard": "readAndWrite"
  },
  "entrypoints": [
    {
      "type": "panel",
      "id": "syncuPanel",
      "label": {
        "default": "Syncu"
      },
      "minimumSize": {
        "width": 280,
        "height": 360
      },
      "maximumSize": {
        "width": 2000,
        "height": 2000
      },
      "preferredDockedSize": {
        "width": 340,
        "height": 620
      },
      "preferredFloatingSize": {
        "width": 420,
        "height": 680
      }
    }
  ]
}
